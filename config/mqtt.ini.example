# Konfiguracja publikatora MQTT (usługa piec-mqtt).
# Na Pi plik leży w /home/pi/mqtt.ini, właściciel pi, prawa 600 - jest tu hasło.
# Edycja bez sudo: nano /home/pi/mqtt.ini
# Tego pliku z hasłem NIE dodawaj do gita. W repo jest tylko ten szablon.

[mqtt]
# tak = usługa publikuje dane do brokera; nie = usługa nic nie robi
wlaczone = nie

# broker (dodatek Mosquitto w Home Assistant), adres widziany z Pi przez VPN
host = 192.168.2.X
port = 1883
uzytkownik =
haslo =
tls = nie

# sekundy; po ok. 1,5 x keepalive bez kontaktu broker ogłosi piec/polaczenie = offline
keepalive = 30

# miejsca po przecinku dla temperatur wysyłanych do MQTT (mniej zapisów w historii HA);
# dotyczy tylko MQTT - odczyty.json i all.php zostają dokładne. -1 = bez zaokrąglania
zaokraglenie_temp = 1

client_id = piec-kpol
prefiks = piec
discovery_prefiks = homeassistant
